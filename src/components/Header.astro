---
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import site from '../data/site.json';
import { mainNav, departments, libraryCategories } from '../data/navigation';

interface Props { current?: string; overlay?: boolean }
const { overlay = false } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) => path === href || path.startsWith(href + '/');

const socials = [
  { key: 'youtube', label: 'YouTube' },
  { key: 'telegram', label: 'Telegram' },
  { key: 'instagram', label: 'Instagram' },
  { key: 'facebook', label: 'Facebook' },
].filter((s) => (site.social as Record<string, string>)[s.key]);
const live = site.live.isLive;
---
<!-- Side rail (wide screens): live link, service times, socials. Echoes Petra's vertical rail. -->
<aside class="rail" aria-label="Service times and social media">
  <a href="/library/live" class:list={['rail__live', { 'is-live': live }]}>
    <span class="dot" aria-hidden="true"></span>
    <span class="rail__text">{live ? 'Live now' : 'Join us online'}</span>
  </a>
  <p class="rail__text rail__times">{site.services.map((s) => `${s.day}s ${s.time}`).join('  ·  ')}</p>
  {socials.length > 0 && (
    <ul class="rail__social">
      {socials.map((s) => (
        <li><a href={(site.social as Record<string, string>)[s.key]} rel="noopener" target="_blank"><Icon name={s.key} size={17} label={s.label} /></a></li>
      ))}
    </ul>
  )}
</aside>

<header class:list={['site-header', { 'site-header--overlay': overlay }]} data-header>
  <div class="container site-header__inner">
    {overlay ? <><span class="logo-swap logo-swap--dark"><Logo variant="dark" /></span><span class="logo-swap logo-swap--light"><Logo /></span></> : <Logo />}

    <nav class="nav" aria-label="Main">
      <ul class="nav__list">
        {mainNav.map((item) => (
          <li class="nav__item">
            {item.menu ? (
              <>
                <button
                  type="button"
                  class:list={['nav__link', { 'is-current': isCurrent(item.href) }]}
                  aria-expanded="false"
                  aria-controls={`menu-${item.menu}`}
                  data-dropdown-toggle
                >
                  {item.label}<Icon name="chevron-down" size={15} class="nav__chev" />
                </button>
                <div class="dropdown" id={`menu-${item.menu}`} data-dropdown hidden>
                  {item.menu === 'departments' ? (
                    <div class="dropdown__grid dropdown__grid--dept">
                      <div class="dropdown__intro">
                        <p class="dropdown__title">Departments</p>
                        <p>Nine departments serve the life of GMI. Find where you fit.</p>
                        <a class="btn btn--outline btn--sm" href="/departments">All departments <Icon name="arrow-right" /></a>
                      </div>
                      <ul class="dropdown__items">
                        {departments.map((d) => (
                          <li><a href={`/departments/${d.slug}`}><strong>{d.name}</strong>{d.summary && <span>{d.summary}</span>}</a></li>
                        ))}
                      </ul>
                    </div>
                  ) : (
                    <div class="dropdown__grid">
                      <form class="dropdown__search" action="/library/search" role="search">
                        <label class="sr-only" for="lib-search-desktop">Search the Digital Library</label>
                        <Icon name="search" size={18} />
                        <input id="lib-search-desktop" name="q" type="search" placeholder="Search messages, music and resources" />
                      </form>
                      <ul class="dropdown__items dropdown__items--lib">
                        {libraryCategories.map((c) => (
                          <li><a href={c.href}><strong>{c.name}</strong><span>{c.summary}</span></a></li>
                        ))}
                      </ul>
                      <a class="link-arrow dropdown__more" href="/library">Library home <Icon name="arrow-right" /></a>
                    </div>
                  )}
                </div>
              </>
            ) : (
              <a href={item.href} class:list={['nav__link', { 'is-current': isCurrent(item.href) }]} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>
            )}
          </li>
        ))}
      </ul>
    </nav>

    <a href="/plan-your-visit" class="btn btn--gold btn--sm header-cta">Plan Your Visit</a>

    <div class="mobile-bar">
      <a href="/new-here" class="btn btn--primary btn--sm">New Here?</a>
      <button type="button" class="menu-btn" aria-expanded="false" aria-controls="mobile-menu" data-menu-open>
        <Icon name="menu" size={20} /> Menu
      </button>
    </div>
  </div>
</header>

<div class="mobile-menu" id="mobile-menu" role="dialog" aria-modal="true" aria-label="Menu" hidden data-menu>
  <div class="mobile-menu__top">
    <Logo variant="dark" />
    <button type="button" class="menu-btn" data-menu-close><Icon name="x" size={20} /> Close</button>
  </div>
  <div class="mobile-menu__body">
    <div class="mobile-menu__ctas">
      <a href="/new-here" class="btn btn--primary">New Here? Become a Member</a>
      <a href="/plan-your-visit" class="btn btn--gold">Plan Your Visit</a>
    </div>
    <ul class="mobile-nav">
      <li><a href="/" aria-current={path === '/' ? 'page' : undefined}>Home</a></li>
      {mainNav.map((item) => (
        <li>
          {item.menu ? (
            <>
              <button type="button" aria-expanded="false" data-accordion>{item.label === 'Digital Library' ? 'GMI Digital Library' : item.label}<span class="pm" aria-hidden="true"></span></button>
              <ul class="mobile-nav__sub" hidden>
                {item.menu === 'departments' ? (
                  <>
                    <li><a href="/departments">All departments</a></li>
                    {departments.map((d) => <li><a href={`/departments/${d.slug}`}>{d.name}</a></li>)}
                  </>
                ) : (
                  <>
                    <li>
                      <form action="/library/search" role="search" class="mobile-search">
                        <label class="sr-only" for="lib-search-mobile">Search the Digital Library</label>
                        <Icon name="search" size={18} />
                        <input id="lib-search-mobile" name="q" type="search" placeholder="Search messages and resources" />
                      </form>
                    </li>
                    <li><a href="/library">Library home</a></li>
                    {libraryCategories.map((c) => <li><a href={c.href}>{c.name}</a></li>)}
                  </>
                )}
              </ul>
            </>
          ) : (
            <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label === 'About' ? 'About GMI' : item.label === 'Services' ? 'Our Services' : item.label === 'Calendar' ? 'Church Calendar' : item.label === 'Giving' ? 'Giving & Partnership' : item.label === 'Contact' ? 'Contact Us' : item.label}</a>
          )}
        </li>
      ))}
      <li><a href="/library/live" class="mobile-nav__live"><span class="dot" aria-hidden="true"></span> Watch Live</a></li>
    </ul>
  </div>
</div>

<style>
  /* Side rail */
  .rail { display: none; }
  @media (min-width: 1181px) {
    .rail {
      position: fixed; left: 0; top: 0; bottom: 0; z-index: 60; width: var(--rail);
      display: flex; flex-direction: column; align-items: center; justify-content: space-between; gap: var(--s-5);
      padding: 120px 0 var(--s-6); background: var(--white); border-right: 1px solid var(--line);
    }
  }
  .rail__text { writing-mode: vertical-rl; transform: rotate(180deg); white-space: pre; font-size: 0.75rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--ink-3); margin: 0; }
  .rail__live { display: flex; flex-direction: column; align-items: center; gap: 12px; text-decoration: none; }
  .rail__live:hover .rail__text { color: var(--blue-700); }
  .rail__times { flex: 1; display: flex; align-items: center; }
  .rail__social { display: flex; flex-direction: column; gap: var(--s-3); list-style: none; margin: 0; padding: 0; }
  .rail__social a { display: grid; place-items: center; width: 36px; height: 36px; border-radius: 50%; color: var(--ink-2); transition: background 0.2s var(--ease), color 0.2s var(--ease); }
  .rail__social a:hover { background: var(--gold-100); color: var(--gold-700); }
  .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--gold-500); box-shadow: 0 0 0 3px rgba(217, 166, 58, 0.25); flex-shrink: 0; }
  .is-live .dot { background: #e5484d; box-shadow: 0 0 0 3px rgba(229, 72, 77, 0.3); animation: pulse 1.6s infinite; }
  @keyframes pulse { 50% { box-shadow: 0 0 0 7px rgba(229, 72, 77, 0); } }

  /* Main header */
  .site-header { position: sticky; top: 0; z-index: 50; background: rgba(255, 255, 255, 0.92); backdrop-filter: blur(14px) saturate(1.4); border-bottom: 1px solid var(--line); transition: background 0.35s var(--ease), border-color 0.35s var(--ease), box-shadow 0.35s var(--ease); }
  .site-header.is-scrolled { box-shadow: 0 10px 30px -18px rgba(10, 15, 38, 0.35); }
  .site-header__inner { position: relative; display: flex; align-items: center; gap: var(--s-4); min-height: 84px; transition: min-height 0.35s var(--ease); }
  .site-header.is-scrolled .site-header__inner { min-height: 72px; }

  /* Overlay variant: transparent over a dark hero, solid once scrolled */
  .site-header--overlay { position: fixed; left: var(--rail); right: 0; background: transparent; border-color: transparent; backdrop-filter: none; }
  .site-header--overlay:not(.is-scrolled) .nav__link { color: rgba(255, 255, 255, 0.92); }
  .site-header--overlay:not(.is-scrolled) .nav__link:hover, .site-header--overlay:not(.is-scrolled) .nav__link[aria-expanded='true'] { color: var(--gold-400); }
  .site-header--overlay:not(.is-scrolled) .menu-btn { background: rgba(255, 255, 255, 0.12); border-color: rgba(255, 255, 255, 0.4); color: var(--white); }
  .site-header--overlay:not(.is-scrolled) .mobile-bar .btn--primary { background: var(--white); color: var(--blue-900); }
  .site-header--overlay.is-scrolled { background: rgba(255, 255, 255, 0.94); backdrop-filter: blur(14px) saturate(1.4); border-color: var(--line); }
  .logo-swap { display: contents; }
  .site-header--overlay:not(.is-scrolled) .logo-swap--light, .site-header--overlay.is-scrolled .logo-swap--dark { display: none; }

  .nav { margin-left: auto; }
  .nav__list { display: flex; align-items: center; gap: 2px; list-style: none; margin: 0; padding: 0; }
  .nav__link {
    position: relative; display: inline-flex; align-items: center; gap: 3px; padding: 10px 10px;
    background: none; border: 0; cursor: pointer; font-size: var(--fs-nav); font-weight: 600; color: var(--ink); text-decoration: none; white-space: nowrap;
    transition: color 0.2s var(--ease);
  }
  .nav__link::after { content: ''; position: absolute; left: 10px; right: 10px; bottom: 3px; height: 2px; background: var(--gold-500); border-radius: 2px; transform: scaleX(0); transform-origin: left; transition: transform 0.3s var(--ease-out); }
  .nav__link:hover::after, .nav__link.is-current::after { transform: scaleX(1); }
  .nav__link:hover, .nav__link[aria-expanded='true'], .nav__link.is-current { color: var(--blue-700); }
  :global(.nav__chev) { transition: transform 0.2s var(--ease); }
  .nav__link[aria-expanded='true'] :global(.nav__chev) { transform: rotate(180deg); }
  .header-cta { margin-left: var(--s-2); }

  /* Dropdowns */
  .dropdown {
    position: absolute; left: var(--gutter); right: var(--gutter); top: calc(100% + 1px); max-width: var(--container); margin-inline: auto;
    background: var(--white); border: 1px solid var(--line); border-radius: 0 0 var(--r-panel) var(--r-panel); box-shadow: var(--shadow-lg); padding: var(--s-6);
    animation: dropIn 0.28s var(--ease-out);
  }
  @keyframes dropIn { from { opacity: 0; transform: translateY(-8px); } }
  .dropdown__grid { display: grid; gap: var(--s-5); }
  .dropdown__grid--dept { grid-template-columns: 240px 1fr; gap: var(--s-6); }
  .dropdown__intro { padding-right: var(--s-5); border-right: 1px solid var(--line); }
  .dropdown__intro p { font-size: var(--fs-small); }
  .dropdown__title { font-size: var(--fs-h3) !important; font-weight: 700; color: var(--blue-900); line-height: 1.2; margin-bottom: var(--s-2); }
  .dropdown__intro .btn { margin-top: var(--s-4); }
  .dropdown__items { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 4px; }
  .dropdown__items--lib { grid-template-columns: repeat(4, 1fr); }
  .dropdown__items a { display: flex; flex-direction: column; gap: 2px; padding: 12px 14px; border-radius: var(--r-input); text-decoration: none; transition: background 0.2s var(--ease), transform 0.2s var(--ease); }
  .dropdown__items a:hover { background: var(--stone); transform: translateX(3px); }
  .dropdown__items strong { color: var(--blue-900); font-size: var(--fs-nav); font-weight: 700; }
  .dropdown__items span { color: var(--ink-3); font-size: 0.8125rem; line-height: 1.4; }
  .dropdown__search, .mobile-search {
    display: flex; align-items: center; gap: 10px; padding: 0 16px; min-height: 52px;
    border: 1.5px solid var(--line); border-radius: var(--r-btn); background: var(--stone); color: var(--ink-3);
  }
  .dropdown__search:focus-within { border-color: var(--blue-700); box-shadow: 0 0 0 3px var(--blue-100); }
  .dropdown__search input, .mobile-search input { flex: 1; border: 0; background: none; outline: none; min-width: 0; color: var(--ink); }
  .dropdown__more { justify-self: start; }

  /* Mobile bar */
  .mobile-bar { display: none; margin-left: auto; align-items: center; gap: var(--s-2); }
  .menu-btn {
    display: inline-flex; align-items: center; gap: 8px; min-height: 44px; padding: 0 16px; border-radius: var(--r-btn);
    border: 1.5px solid var(--line); background: var(--white); font-weight: 700; font-size: var(--fs-nav); color: var(--blue-900); cursor: pointer;
  }

  /* Full-screen menu: dark glow sheet, links slide in one after another */
  .mobile-menu { position: fixed; inset: 0; z-index: 100; overflow-y: auto; color: var(--white); background: var(--glow-hero); background-color: var(--blue-950); }
  .mobile-menu:not([hidden]) { animation: menuIn 0.45s var(--ease-out); }
  @keyframes menuIn { from { opacity: 0; clip-path: circle(0% at calc(100% - 60px) 40px); } to { opacity: 1; clip-path: circle(150% at calc(100% - 60px) 40px); } }
  .mobile-menu__top { display: flex; align-items: center; justify-content: space-between; padding: 12px var(--gutter); min-height: 76px; position: sticky; top: 0; background: rgba(10, 15, 38, 0.7); backdrop-filter: blur(10px); z-index: 1; }
  .mobile-menu .menu-btn { background: rgba(255, 255, 255, 0.1); border-color: rgba(255, 255, 255, 0.3); color: var(--white); }
  .mobile-menu__body { padding: var(--s-5) var(--gutter) var(--s-8); }
  .mobile-menu__ctas { display: grid; gap: var(--s-3); margin-bottom: var(--s-5); }
  .mobile-menu__ctas .btn--primary { background: var(--white); color: var(--blue-900); }
  .mobile-nav { list-style: none; margin: 0; padding: 0; }
  .mobile-nav > li { border-bottom: 1px solid rgba(255, 255, 255, 0.14); }
  .mobile-menu:not([hidden]) .mobile-nav > li { animation: itemIn 0.5s var(--ease-out) both; }
  .mobile-nav > li:nth-child(2) { animation-delay: 0.04s !important; } .mobile-nav > li:nth-child(3) { animation-delay: 0.08s !important; }
  .mobile-nav > li:nth-child(4) { animation-delay: 0.12s !important; } .mobile-nav > li:nth-child(5) { animation-delay: 0.16s !important; }
  .mobile-nav > li:nth-child(6) { animation-delay: 0.2s !important; } .mobile-nav > li:nth-child(7) { animation-delay: 0.24s !important; }
  .mobile-nav > li:nth-child(8) { animation-delay: 0.28s !important; } .mobile-nav > li:nth-child(n + 9) { animation-delay: 0.32s !important; }
  @keyframes itemIn { from { opacity: 0; transform: translateX(28px); } }
  .mobile-nav a, .mobile-nav button {
    display: flex; align-items: center; justify-content: space-between; width: 100%; min-height: 60px;
    padding: 0; background: none; border: 0; text-align: left; cursor: pointer;
    font-size: 1.5rem; font-weight: 300; letter-spacing: -0.02em; color: var(--white); text-decoration: none;
  }
  .mobile-nav a:hover, .mobile-nav button:hover { color: var(--gold-400); }
  .mobile-nav a[aria-current='page'] { color: var(--gold-400); font-weight: 700; }
  .pm { position: relative; width: 16px; height: 16px; }
  .pm::before, .pm::after { content: ''; position: absolute; left: 0; right: 0; top: 7px; height: 2px; background: var(--gold-400); transition: transform 0.2s var(--ease); }
  .pm::after { transform: rotate(90deg); }
  [aria-expanded='true'] > .pm::after { transform: rotate(0); }
  .mobile-nav__sub { list-style: none; margin: 0 0 var(--s-4); padding: 0 0 0 var(--s-4); border-left: 2px solid var(--gold-500); }
  .mobile-nav__sub a { min-height: 46px; font-size: 1rem; font-weight: 600; letter-spacing: 0; color: rgba(255, 255, 255, 0.85); }
  .mobile-nav__sub li:has(form) { padding: var(--s-2) 0; }
  .mobile-search { background: rgba(255, 255, 255, 0.08); border-color: rgba(255, 255, 255, 0.25); color: rgba(255, 255, 255, 0.7); }
  .mobile-search input { color: var(--white); }
  .mobile-search input::placeholder { color: rgba(255, 255, 255, 0.6); }
  .mobile-nav__live { justify-content: flex-start !important; gap: 12px; }

  @media (max-width: 1180px) {
    .nav, .header-cta { display: none; }
    .mobile-bar { display: flex; }
    .site-header__inner, .site-header.is-scrolled .site-header__inner { min-height: 68px; }
  }
  @media (max-width: 520px) {
    .site-header :global(.logo__text) { display: none; }
    .menu-btn { padding: 0 14px; }
  }
</style>

<script>
  // Desktop dropdowns: open on click or Enter, close on Esc / outside click.
  const toggles = document.querySelectorAll<HTMLButtonElement>('[data-dropdown-toggle]');
  const closeAll = (except?: HTMLButtonElement) => {
    toggles.forEach((t) => {
      if (t === except) return;
      t.setAttribute('aria-expanded', 'false');
      const panel = document.getElementById(t.getAttribute('aria-controls')!);
      if (panel) panel.hidden = true;
    });
  };
  toggles.forEach((btn) => {
    const panel = document.getElementById(btn.getAttribute('aria-controls')!)!;
    btn.addEventListener('click', () => {
      const open = btn.getAttribute('aria-expanded') === 'true';
      closeAll(btn);
      btn.setAttribute('aria-expanded', String(!open));
      panel.hidden = open;
      if (!open) panel.querySelector<HTMLInputElement>('input')?.focus();
    });
    panel.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') { closeAll(); btn.focus(); }
    });
  });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeAll(); });
  document.addEventListener('click', (e) => {
    if (!(e.target as HTMLElement).closest('.nav__item')) closeAll();
  });

  // Mobile menu: full-screen sheet with focus kept inside.
  const menu = document.querySelector<HTMLElement>('[data-menu]')!;
  const openBtn = document.querySelector<HTMLButtonElement>('[data-menu-open]')!;
  const closeBtn = document.querySelector<HTMLButtonElement>('[data-menu-close]')!;
  const focusables = () => Array.from(menu.querySelectorAll<HTMLElement>('a, button, input')).filter((el) => el.offsetParent !== null);
  const setMenu = (open: boolean) => {
    menu.hidden = !open;
    openBtn.setAttribute('aria-expanded', String(open));
    document.body.style.overflow = open ? 'hidden' : '';
    (open ? closeBtn : openBtn).focus();
  };
  openBtn.addEventListener('click', () => setMenu(true));
  closeBtn.addEventListener('click', () => setMenu(false));
  menu.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') return setMenu(false);
    if (e.key !== 'Tab') return;
    const f = focusables();
    const first = f[0], last = f[f.length - 1];
    if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
    else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
  });
  menu.querySelectorAll<HTMLButtonElement>('[data-accordion]').forEach((b) => {
    b.addEventListener('click', () => {
      const open = b.getAttribute('aria-expanded') === 'true';
      b.setAttribute('aria-expanded', String(!open));
      (b.nextElementSibling as HTMLElement).hidden = open;
    });
  });
  window.matchMedia('(min-width: 1181px)').addEventListener('change', (m) => { if (m.matches && !menu.hidden) setMenu(false); });
</script>
