---
// Inner-page hero: stone background, breadcrumbs, eyebrow, headline, intro, optional buttons, glory rays.
import GloryRays from './GloryRays.astro';

interface Crumb { label: string; href?: string }
interface Props {
  eyebrow: string;
  title: string; // may contain <em> for the gold italic word
  intro?: string;
  introPlaceholder?: string;
  crumbs: Crumb[];
  dark?: boolean;
  watermark?: string; // big faded word behind the hero (defaults to the eyebrow)
}
const { eyebrow, title, intro, introPlaceholder, crumbs, dark = false, watermark } = Astro.props;
---
<section class:list={['page-hero watermark-host', { 'page-hero--dark on-dark': dark }]}>
  <span class="watermark page-hero__mark" aria-hidden="true">{(watermark ?? eyebrow).toUpperCase()}</span>
  <GloryRays class="page-hero__rays" opacity={dark ? 0.3 : 0.45} color={dark ? 'var(--gold-400)' : 'var(--gold-500)'} />
  <div class="container page-hero__inner">
    <nav aria-label="Breadcrumb">
      <ol class="crumbs">
        {crumbs.map((c, i) => (
          <li>{c.href && i < crumbs.length - 1 ? <a href={c.href}>{c.label}</a> : <span aria-current="page">{c.label}</span>}</li>
        ))}
      </ol>
    </nav>
    <p class="eyebrow">{eyebrow}</p>
    <h1 set:html={title} />
    {intro ? <p class="page-hero__intro">{intro}</p> : introPlaceholder && <p class="page-hero__intro ph">{introPlaceholder}</p>}
    {Astro.slots.has('default') && <div class="page-hero__actions"><slot /></div>}
  </div>
</section>

<style>
  .page-hero { position: relative; overflow: hidden; background: var(--stone); padding: calc(var(--s-8) + 8px) 0 var(--s-9); }
  .page-hero::before { content: ''; position: absolute; z-index: -1; right: -10%; top: -40%; width: 60%; height: 140%; background: radial-gradient(closest-side, rgba(217, 166, 58, 0.22), transparent 70%); pointer-events: none; }
  .page-hero::after { content: ''; position: absolute; z-index: -1; left: -15%; bottom: -60%; width: 50%; height: 120%; background: radial-gradient(closest-side, rgba(53, 80, 200, 0.12), transparent 70%); pointer-events: none; }
  .page-hero--dark { background: var(--blue-950); }
  .page-hero__mark { top: 62%; left: 62%; font-size: clamp(5rem, 14vw, 12.5rem); }
  :global(.page-hero__rays) { right: -80px; bottom: -40px; width: 620px; height: 360px; }
  .page-hero__inner { position: relative; }
  .crumbs { display: flex; flex-wrap: wrap; gap: 6px; list-style: none; margin: 0 0 var(--s-6); padding: 0; font-size: 0.8125rem; font-weight: 600; color: var(--ink-3); }
  .crumbs li + li::before { content: '/'; margin-right: 6px; color: var(--line-strong); }
  .crumbs a { color: var(--ink-2); text-decoration: none; }
  .crumbs a:hover { color: var(--blue-700); text-decoration: underline; }
  .on-dark .crumbs, .on-dark .crumbs a { color: rgba(255, 255, 255, 0.7); }
  h1 { max-width: 820px; font-size: clamp(2.5rem, 1.6rem + 3.4vw, 4.25rem); }
  .page-hero__intro { max-width: 620px; margin-top: var(--s-5); font-size: var(--fs-body-lg); line-height: 1.65; }
  .page-hero__actions { display: flex; flex-wrap: wrap; gap: var(--s-3); margin-top: var(--s-6); }
  @media (max-width: 760px) {
    :global(.page-hero__rays) { opacity: 0.25 !important; }
    .page-hero__mark { top: 78%; left: 50%; }
  }
</style>
