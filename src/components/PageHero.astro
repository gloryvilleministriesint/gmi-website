---
// Inner-page hero: stone background, breadcrumbs, eyebrow, headline, intro, optional buttons, glory rays.
import GloryRays from './GloryRays.astro';

interface Crumb { label: string; href?: string }
interface Props {
  eyebrow: string;
  title: string; // may contain <em> for the gold italic word
  intro?: string;
  introPlaceholder?: string;
  crumbs: Crumb[];
  dark?: boolean;
}
const { eyebrow, title, intro, introPlaceholder, crumbs, dark = false } = Astro.props;
---
<section class:list={['page-hero', { 'page-hero--dark on-dark': dark }]}>
  <GloryRays class="page-hero__rays" opacity={dark ? 0.3 : 0.45} color={dark ? 'var(--gold-400)' : 'var(--gold-500)'} />
  <div class="container page-hero__inner">
    <nav aria-label="Breadcrumb">
      <ol class="crumbs">
        {crumbs.map((c, i) => (
          <li>{c.href && i < crumbs.length - 1 ? <a href={c.href}>{c.label}</a> : <span aria-current="page">{c.label}</span>}</li>
        ))}
      </ol>
    </nav>
    <p class="eyebrow">{eyebrow}</p>
    <h1 set:html={title} />
    {intro ? <p class="page-hero__intro">{intro}</p> : introPlaceholder && <p class="page-hero__intro ph">{introPlaceholder}</p>}
    {Astro.slots.has('default') && <div class="page-hero__actions"><slot /></div>}
  </div>
</section>

<style>
  .page-hero { position: relative; overflow: hidden; background: var(--stone); padding: var(--s-7) 0 var(--s-8); }
  .page-hero--dark { background: var(--blue-950); }
  :global(.page-hero__rays) { right: -80px; bottom: -40px; width: 620px; height: 360px; }
  .page-hero__inner { position: relative; }
  .crumbs { display: flex; flex-wrap: wrap; gap: 6px; list-style: none; margin: 0 0 var(--s-5); padding: 0; font-size: 0.8125rem; color: var(--ink-3); }
  .crumbs li + li::before { content: '/'; margin-right: 6px; color: var(--line-strong); }
  .crumbs a { color: var(--ink-2); text-decoration: none; }
  .crumbs a:hover { color: var(--blue-700); text-decoration: underline; }
  .on-dark .crumbs, .on-dark .crumbs a { color: rgba(255, 255, 255, 0.7); }
  h1 { max-width: 760px; }
  .page-hero__intro { max-width: 600px; margin-top: var(--s-4); font-size: var(--fs-body-lg); line-height: 1.6; }
  .page-hero__actions { display: flex; flex-wrap: wrap; gap: var(--s-3); margin-top: var(--s-5); }
  @media (max-width: 760px) {
    :global(.page-hero__rays) { opacity: 0.25 !important; }
  }
</style>
