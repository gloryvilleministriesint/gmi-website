---
// Message card: thumbnail with format and duration, series label, title, speaker · topic · date.
import Icon from './Icon.astro';
import { formatOf, longDate, youtubeId, type Message } from '../lib/messages';

interface Props { m: Message; meta?: 'full' | 'short'; headingLevel?: 'h2' | 'h3' }
const { m, meta = 'full', headingLevel = 'h3' } = Astro.props;
const d = m.data;
const H = headingLevel;
const id = youtubeId(d.youtube);
const thumb = d.artwork ?? (id ? `https://i.ytimg.com/vi/${id}/hqdefault.jpg` : null);
const format = formatOf(m);
---
<article class="mcard">
  <a class="mcard__link" href={`/library/messages/${m.id}`}>
    <div class="img-slot img-slot--dark mcard__thumb">
      {thumb ? <img src={thumb} alt="" loading="lazy" /> : <span class="img-label"><Icon name="video" />Thumbnail</span>}
      {meta === 'full' && <span class="mcard__format">{format}</span>}
      {meta === 'full' && <span class:list={['mcard__time', { ph: !d.duration }]}>{d.duration ?? '[mm:ss]'}</span>}
    </div>
    <p class="mcard__series">{d.series ?? 'Standalone'}</p>
    <H class="mcard__title">{d.title}</H>
  </a>
  <p class="mcard__meta">
    {meta === 'full' ? (
      <>
        <span class:list={{ ph: !d.speaker }}>{d.speaker ?? '[Speaker]'}</span>
        {d.topics[0] && <span>{d.topics[0]}</span>}
        <span class:list={{ ph: d.sample }}>{d.sample ? '[Date]' : longDate(d.date)}</span>
      </>
    ) : (
      <>
        <span class:list={{ ph: d.sample || !d.speaker }}>{d.sample || !d.speaker ? '[Speaker]' : d.speaker}</span>
        <span class:list={{ ph: d.sample }}>{d.sample ? '[Date]' : longDate(d.date)}</span>
      </>
    )}
  </p>
</article>

<style>
  .mcard__link { display: block; text-decoration: none; }
  .mcard__thumb { position: relative; aspect-ratio: 16 / 9; border-radius: var(--r-card); overflow: hidden; margin-bottom: var(--s-4); }
  .mcard__thumb img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s var(--ease); }
  .mcard__link:hover img { transform: scale(1.03); }
  .mcard__format { position: absolute; top: 10px; left: 10px; padding: 3px 9px; border-radius: 6px; background: var(--blue-950); color: var(--white); font-size: 0.75rem; font-weight: 700; }
  .mcard__time { position: absolute; right: 10px; bottom: 10px; padding: 2px 8px; border-radius: 6px; background: rgba(10, 22, 51, 0.8); border: 1px solid rgba(255, 255, 255, 0.2); color: var(--white); font-size: 0.75rem; }
  .mcard__time.ph { color: rgba(255, 255, 255, 0.6); }
  .mcard__series { font-size: 0.75rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--ink-2); margin-bottom: 6px; }
  .mcard__title { font-family: var(--font-serif); font-weight: 500; font-size: 1.375rem; line-height: 1.25; color: var(--blue-900); margin: 0 0 var(--s-2); }
  .mcard__link:hover .mcard__title { text-decoration: underline; text-underline-offset: 3px; }
  .mcard__meta { display: flex; flex-wrap: wrap; gap: 4px 0; margin: 0; font-size: var(--fs-small); color: var(--ink-2); }
  .mcard__meta span + span::before { content: '•'; margin: 0 10px; color: var(--line-strong); font-style: normal; }
</style>
