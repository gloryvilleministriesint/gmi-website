---
import Base from '../../../layouts/Base.astro';
import Icon from '../../../components/Icon.astro';
import LibraryHeader from '../../../components/LibraryHeader.astro';
import { getBooks } from '../../../lib/library';
import '../../../styles/library.css';

const books = await getBooks();
---
<Base title="Recommended Books" description="Books recommended by the leadership of Gloryville Ministries International.">
  <LibraryHeader title="Recommended <strong>Books</strong>" current="/library/books" crumb="Recommended Books" intro="Books recommended by GMI's leadership for growth in faith and life." />

  <section class="section">
    <div class="container">
      {books.length === 0 ? (
        <div class="lib-empty"><h2 class="h3">Book recommendations are coming soon</h2></div>
      ) : (
        <ul class="lib-grid lib-grid--4">
          {books.map((b, i) => (
            <li>
              <a class="lib-card" href={`/library/books/${b.id}`}>
                <div class:list={['img-slot cover', { 'img-slot--warm': i % 2 === 1 }]}>
                  {b.data.cover ? <img src={b.data.cover} alt={`Cover of ${b.data.title} by ${b.data.author}`} loading="lazy" /> : <span class="img-label"><Icon name="book" />Book cover</span>}
                </div>
                <h2 class="lib-card__title">{b.data.title}</h2>
                <p class:list={['lib-card__meta', { ph: b.data.author.startsWith('[') }]}>{b.data.author}</p>
                {b.data.recommendedBy && <p class="lib-card__meta rec">Recommended by {b.data.recommendedBy}</p>}
              </a>
            </li>
          ))}
        </ul>
      )}
    </div>
  </section>
</Base>

<style>
  .cover { aspect-ratio: 2 / 3; border-radius: var(--r-input); overflow: hidden; margin-bottom: var(--s-4); box-shadow: var(--shadow-md); }
  .cover img { width: 100%; height: 100%; object-fit: cover; }
  .rec { margin-top: 4px; color: var(--gold-700); font-weight: 600; }
</style>
