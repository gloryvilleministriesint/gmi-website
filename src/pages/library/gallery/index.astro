---
import Base from '../../../layouts/Base.astro';
import Icon from '../../../components/Icon.astro';
import LibraryHeader from '../../../components/LibraryHeader.astro';
import YouTubeLite from '../../../components/YouTubeLite.astro';
import { getAlbums, longDate } from '../../../lib/library';
import '../../../styles/library.css';

const albums = await getAlbums();
const videos = albums.flatMap((a) => a.data.videos.map((v) => ({ ...v, album: a })));
const kinds = [...new Set(albums.map((a) => a.data.kind))];
const photoCount = (a: (typeof albums)[number]) => a.data.photos.length;
---
<Base title="Gallery" description="Photos and videos from services, special occasions and church life at Gloryville Ministries International.">
  <LibraryHeader title="Photo <strong>Gallery</strong>" current="/library/gallery" crumb="Gallery" intro="Church life at GMI, by occasion." />

  <section class="section" data-gallery>
    <div class="container">
      {albums.length === 0 ? (
        <div class="lib-empty"><h2 class="h3">Photos are coming soon</h2><p>Albums from services and special occasions will appear here.</p></div>
      ) : (
        <>
          <div class="tabs-row">
            <div class="lib-chips" role="tablist" aria-label="Gallery">
              <button type="button" class="lib-chip" role="tab" id="tab-photos" aria-controls="panel-photos" aria-selected="true">Photos <span class="count">{albums.length} albums</span></button>
              <button type="button" class="lib-chip" role="tab" id="tab-videos" aria-controls="panel-videos" aria-selected="false" tabindex="-1">Videos <span class="count">{videos.length}</span></button>
            </div>
            {kinds.length > 1 && (
              <div class="field kind">
                <label for="kind" class="sr-only">Occasion</label>
                <select id="kind" data-kind><option value="">All occasions</option>{kinds.map((k) => <option>{k}</option>)}</select>
              </div>
            )}
          </div>

          <div role="tabpanel" id="panel-photos" aria-labelledby="tab-photos">
            <ul class="lib-grid">
              {albums.map((a, i) => (
                <li data-kind-item={a.data.kind}>
                  <a class="lib-card" href={`/library/gallery/${a.id}`}>
                    <div class:list={['img-slot lib-card__img', { 'img-slot--warm': i % 2 === 0 }]}>
                      {a.data.cover ?? a.data.photos[0]?.src
                        ? <img src={a.data.cover ?? a.data.photos[0].src} alt="" loading="lazy" decoding="async" />
                        : <span class="img-label"><Icon name="image" />Album cover</span>}
                    </div>
                    <p class="lib-card__kicker">{a.data.kind}</p>
                    <h2 class="lib-card__title">{a.data.title}</h2>
                    <p class="lib-card__meta">
                      <span class:list={{ ph: a.data.sample }}>{a.data.sample ? '[Date]' : longDate(a.data.date)}</span>
                      {' · '}
                      <span class:list={{ ph: a.data.sample && !photoCount(a) }}>{a.data.sample && !photoCount(a) ? '[Photo count]' : `${photoCount(a)} photos`}</span>
                      {a.data.videos.length > 0 && ` · ${a.data.videos.length} ${a.data.videos.length === 1 ? 'video' : 'videos'}`}
                    </p>
                  </a>
                </li>
              ))}
            </ul>
          </div>

          <div role="tabpanel" id="panel-videos" aria-labelledby="tab-videos" hidden>
            {videos.length === 0 ? (
              <div class="lib-empty"><p>No videos yet. Recorded messages are in <a href="/library">Messages and Sermons</a>.</p></div>
            ) : (
              <ul class="lib-grid">
                {videos.map((v) => (
                  <li data-kind-item={v.album.data.kind}>
                    <YouTubeLite video={v.youtube} title={v.title} label="Video" />
                    <p class="lib-card__kicker v-kicker">{v.album.data.kind}</p>
                    <h2 class="lib-card__title">{v.title}</h2>
                    <p class="lib-card__meta">From <a href={`/library/gallery/${v.album.id}`}>{v.album.data.title}</a></p>
                  </li>
                ))}
              </ul>
            )}
          </div>
        </>
      )}
    </div>
  </section>
</Base>

<style>
  .tabs-row { display: flex; justify-content: space-between; align-items: flex-start; gap: var(--s-4); flex-wrap: wrap; }
  .kind select { min-height: 40px; border-radius: var(--r-pill); padding-left: 16px; font-weight: 600; font-size: 0.875rem; }
  [role='tabpanel'][hidden] { display: none; }
  .v-kicker { margin-top: var(--s-4); }
</style>

<script>
  import { initYouTube } from '../../../scripts/yt-lite';
  initYouTube();

  const root = document.querySelector<HTMLElement>('[data-gallery]');
  if (root) {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[role=tab]'));
    const select = (t: HTMLButtonElement, focus = false) => {
      tabs.forEach((x) => {
        const on = x === t;
        x.setAttribute('aria-selected', String(on));
        x.tabIndex = on ? 0 : -1;
        document.getElementById(x.getAttribute('aria-controls')!)!.hidden = !on;
      });
      if (focus) t.focus();
      history.replaceState(null, '', t.id === 'tab-videos' ? '#videos' : location.pathname + location.search);
    };
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => select(t));
      t.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowRight' || e.key === 'ArrowLeft') { e.preventDefault(); select(tabs[(i + (e.key === 'ArrowRight' ? 1 : tabs.length - 1)) % tabs.length], true); }
      });
    });
    if (location.hash === '#videos' && tabs[1]) select(tabs[1]);

    const kind = root.querySelector<HTMLSelectElement>('[data-kind]');
    kind?.addEventListener('change', () => {
      root.querySelectorAll<HTMLElement>('[data-kind-item]').forEach((li) => (li.hidden = Boolean(kind.value) && li.dataset.kindItem !== kind.value));
    });
  }
</script>
