---
// Home (Nov 2026 redesign): structure and motion inspired by petracc.org, colours from the GMI logo.
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import GloryRays from '../components/GloryRays.astro';
import MessageCard from '../components/MessageCard.astro';
import site from '../data/site.json';
import about from '../data/about.json';
import departments from '../data/departments.json';
import { getCollection } from 'astro:content';
import { getMessages } from '../lib/messages';

const tz = 'Africa/Lagos';
const now = new Date();
const fmt = (d: Date, o: Intl.DateTimeFormatOptions) => new Intl.DateTimeFormat('en-GB', { timeZone: tz, ...o }).format(d);

const events = (await getCollection('events'))
  .filter((e) => e.data.repeat !== 'weekly' && (e.data.end ?? e.data.start) >= now)
  .sort((a, b) => +a.data.start - +b.data.start)
  .slice(0, 3);
const messages = (await getMessages()).slice(0, 8);
const nextEvent = events.find((e) => !e.data.sample);

// Hero slides. Facts come from site.json; slide copy beyond the facts is kept short and factual.
const sunday = site.services.find((s) => s.day === 'Sunday') ?? site.services[0];
const midweek = site.services.find((s) => s.day !== sunday.day);
type Slide = { eyebrow: string; title: string; text?: string; ph?: string; ctas: { label: string; href: string; style: 'gold' | 'outline' }[]; art: string; image?: string };
const slides: Slide[] = [
  {
    eyebrow: 'Gloryville Ministries International',
    title: 'You are <em>welcome</em> at Gloryville.',
    text: site.tagline || undefined,
    ph: '[One or two sentences introducing GMI or the theme for the year, supplied by the church]',
    ctas: [{ label: 'Plan Your Visit', href: '/plan-your-visit', style: 'gold' }, { label: 'New here? Start here', href: '/new-here', style: 'outline' }],
    art: 'a',
  },
  {
    eyebrow: sunday.name,
    title: `${sunday.day}s at <em>${sunday.time}</em>`,
    text: `Worship, prayer and the Word at ${site.address.lines.slice(-2).join(', ')}. Come as you are.`,
    ctas: [{ label: 'Plan Your Visit', href: '/plan-your-visit', style: 'gold' }, { label: 'Watch online', href: '/library/live', style: 'outline' }],
    art: 'b',
  },
  ...(midweek ? [{
    eyebrow: midweek.name,
    title: `${midweek.day}s at <em>${midweek.time}</em>`,
    text: 'Pause in the middle of the week for worship and the Word.',
    ctas: [{ label: 'Our Services', href: '/services', style: 'gold' as const }, { label: 'Church Calendar', href: '/calendar', style: 'outline' as const }],
    art: 'c',
  }] : []),
  nextEvent
    ? {
        eyebrow: nextEvent.data.category,
        title: nextEvent.data.title,
        text: `${fmt(nextEvent.data.start, { weekday: 'long', day: 'numeric', month: 'long' })}${nextEvent.data.summary ? `. ${nextEvent.data.summary}` : ''}`,
        ctas: [{ label: nextEvent.data.registration ? 'Register now' : 'Learn more', href: `/calendar/${nextEvent.id}`, style: 'gold' }, { label: 'Church Calendar', href: '/calendar', style: 'outline' }],
        art: 'd',
        image: nextEvent.data.image,
      }
    : {
        eyebrow: 'GMI Digital Library',
        title: 'Hear the Word, <em>wherever you are.</em>',
        text: 'Messages, music, live services and resources from GMI.',
        ctas: [{ label: 'Open the Library', href: '/library', style: 'gold' }, { label: 'Watch live', href: '/library/live', style: 'outline' }],
        art: 'd',
      },
];

const experience = [
  { icon: 'mic', title: 'Messages', text: 'Sermons to watch or hear', href: '/library' },
  { icon: 'music', title: 'Music', text: 'Worship and praise', href: '/library/music' },
  { icon: 'radio', title: 'Live', text: 'Join services online', href: '/library/live' },
  { icon: 'users', title: 'Connect', text: 'Our official channels', href: '/library/connect' },
];

const featureSlugs = ['music-and-arts', 'media-and-publicity', 'children', 'ushering-and-protocol'];
const features = featureSlugs.map((slug) => departments.find((d) => d.slug === slug)).filter((d): d is (typeof departments)[number] => Boolean(d));
const splitName = (name: string) => {
  const words = name.split(' ');
  return { light: words.slice(0, -1).join(' '), bold: words.at(-1) };
};

const steps = [
  { title: 'Plan your first visit', text: `Join us on ${site.services.map((s) => `${s.day}s at ${s.time}`).join(' or ')}. See what to expect, where to find us and how to prepare.`, href: '/plan-your-visit', cta: 'Plan your visit' },
  { title: 'Start the membership journey', text: 'From your first visit to the membership class and beyond: the six steps to becoming part of the GMI family.', href: '/new-here', cta: 'See the journey' },
  { title: 'Serve in a department', text: 'Nine departments serve the life of the church, from music and media to ushering and children.', href: '/departments', cta: 'Explore departments' },
  { title: 'Share your testimony', text: 'Tell the church what God has done. Every testimony is reviewed before it is published.', href: '/testimonies', cta: 'Read and share testimonies' },
  { title: 'Give and partner with GMI', text: 'Tithes, offerings, partnership and seed sowing.', href: '/give', cta: 'Give online' },
];
---
<Base overlay>
  <!-- 1. Hero slider -->
  <section class="hero on-dark" aria-roledescription="carousel" aria-label="Welcome to GMI" data-hero data-no-reveal>
    <div class="hero__slides">
      {slides.map((s, i) => (
        <div class:list={['slide', `slide--${s.art}`, { 'is-active': i === 0 }]} role="group" aria-roledescription="slide" aria-label={`${i + 1} of ${slides.length}`} aria-hidden={i === 0 ? undefined : 'true'} inert={i === 0 ? undefined : true} data-slide>
          <div class="slide__bg" aria-hidden="true">
            {s.image && <img src={s.image} alt="" />}
            <GloryRays class="slide__rays" opacity={0.35} color="var(--gold-400)" />
          </div>
          <div class="container slide__inner">
            <div class="slide__copy">
              <p class="eyebrow slide__anim">{s.eyebrow}</p>
              {i === 0 ? <h1 class="display slide__anim" set:html={s.title} /> : <h2 class="display slide__anim" set:html={s.title} />}
              {s.text ? <p class="slide__text slide__anim">{s.text}</p> : s.ph && <p class="slide__text slide__anim ph">{s.ph}</p>}
              <div class="slide__ctas slide__anim">
                {s.ctas.map((c) => <a class={`btn btn--${c.style}`} href={c.href} tabindex={i === 0 ? undefined : -1}>{c.label}{c.style === 'gold' && <Icon name="arrow-right" />}</a>)}
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>

    <div class="container hero__controls">
      <ol class="hero__dots" aria-label="Choose slide">
        {slides.map((s, i) => (
          <li><button type="button" data-go={i} aria-label={`Slide ${i + 1}: ${s.eyebrow}`} aria-current={i === 0 ? 'true' : undefined}><span class="hero__num">{String(i + 1).padStart(2, '0')}</span><span class="hero__bar"><span></span></span></button></li>
        ))}
      </ol>
      <div class="hero__btns">
        <button type="button" class="hero__btn" data-prev aria-label="Previous slide"><Icon name="arrow-left" size={18} /></button>
        <button type="button" class="hero__btn" data-pause aria-label="Pause slideshow"><Icon name="pause" size={16} class="i-pause" /><Icon name="play" size={16} class="i-play" /></button>
        <button type="button" class="hero__btn" data-next aria-label="Next slide"><Icon name="arrow-right" size={18} /></button>
      </div>
    </div>
    <a class="hero__scroll" href="#about" aria-label="Scroll to content"><span></span></a>
  </section>

  <!-- 2. About -->
  <section class="section about watermark-host" id="about">
    <span class="watermark watermark--top" aria-hidden="true">GLORYVILLE</span>
    <div class="container about__grid">
      <div class="about__copy" data-reveal>
        <p class="eyebrow">About GMI</p>
        <h2>Welcome to <strong>Gloryville</strong> Ministries International</h2>
        <p class="about__quote ph">[A short word or quote from the Senior Pastor]</p>
        {about.intro ? <p class="about__text">{about.intro}</p> : <p class="about__text ph">[Two or three sentences about who GMI is, its vision and mission, supplied by the church]</p>}
        <div class="about__ctas">
          <a class="btn btn--primary" href="/about">Learn more about us</a>
          <a class="link-arrow" href="/new-here">New here? Start here <Icon name="arrow-right" /></a>
        </div>
      </div>
      <div class="about__media" data-reveal="right">
        <span class="about__halo" aria-hidden="true"></span>
        <div class="img-slot arch about__img"><span class="img-label"><Icon name="image" />Photograph: Senior Pastor</span></div>
        <div class="about__badge">
          <span class="about__badge-icon"><Icon name="clock" size={18} /></span>
          <span><strong>{site.services.map((s) => `${s.day.slice(0, 3)} ${s.time}`).join(' · ')}</strong>Service times</span>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. Experience (Library pathways) -->
  <section class="section experience bg-stone watermark-host">
    <span class="watermark" aria-hidden="true" data-dir="right">ENCOUNTER</span>
    <div class="container experience__grid">
      <div class="experience__copy" data-reveal>
        <p class="eyebrow">GMI Digital Library</p>
        <h2>Grow in the Word, <strong>wherever you are</strong></h2>
        <p>Messages, music and live services from GMI, ready when you are: on your phone, at home or on the road.</p>
        <a class="btn btn--gold" href="/library">Open the Digital Library <Icon name="arrow-right" /></a>
      </div>
      <div class="experience__panel">
        <span class="experience__block glow-drift" aria-hidden="true"></span>
        <ul class="experience__cards" data-reveal-group>
          {experience.map((x) => (
            <li>
              <a class="xcard" href={x.href}>
                <span class="xcard__icon"><Icon name={x.icon} size={22} /></span>
                <span class="xcard__title">{x.title}</span>
                <span class="xcard__text">{x.text}</span>
                <span class="xcard__go" aria-hidden="true"><Icon name="arrow-up-right" size={18} /></span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- 4. Latest messages (swipeable row) -->
  {messages.length > 0 && (
    <section class="section messages" aria-labelledby="msgs-h" data-carousel>
      <div class="container">
        <div class="row-head" data-reveal>
          <div>
            <p class="eyebrow">Messages and Sermons</p>
            <h2 id="msgs-h">Latest <strong>Messages</strong></h2>
          </div>
          <div class="row-head__ctl">
            <a class="link-arrow" href="/library">All messages <Icon name="arrow-right" /></a>
            <button type="button" class="round" data-scroll="-1" aria-label="Scroll messages back"><Icon name="arrow-left" size={18} /></button>
            <button type="button" class="round" data-scroll="1" aria-label="Scroll messages forward"><Icon name="arrow-right" size={18} /></button>
          </div>
        </div>
      </div>
      <ul class="track" data-track tabindex="0" aria-label="Latest messages">
        {messages.map((m) => <li class="track__item"><MessageCard m={m} /></li>)}
      </ul>
    </section>
  )}

  <!-- 5. Giving -->
  <section class="section giving bg-stone watermark-host">
    <span class="watermark" aria-hidden="true">GIVING</span>
    <div class="container giving__inner" data-reveal>
      <span class="ping giving__icon"><span class="giving__icon-core"><Icon name="gift" size={26} /></span></span>
      <blockquote class="giving__quote">
        <p>“Every man according as he purposeth in his heart, so let him give; not grudgingly, or of necessity: for God loveth <strong>a cheerful giver</strong>.”</p>
        <cite>2 Corinthians 9:7 (KJV)</cite>
      </blockquote>
      <a class="btn btn--gold" href="/give">Give online <Icon name="arrow-right" /></a>
    </div>
  </section>

  <!-- 6. Departments: staggered feature blocks -->
  <section class="section depts">
    <div class="container">
      <div class="depts__intro" data-reveal>
        <p class="eyebrow">Departments</p>
        <h2>Nine departments. <strong>One church at work.</strong></h2>
        <p>Every department serves the life of GMI. Find where you fit, after the membership class.</p>
      </div>
      <div class="depts__grid">
        {features.map((d, i) => {
          const n = splitName(d.name);
          const isMedia = d.slug === 'media-and-publicity';
          return (
            <article class:list={['feature', { 'feature--offset': i % 2 === 1 }]} data-reveal>
              <a class="feature__media zoom-media" href={`/departments/${d.slug}`} tabindex="-1" aria-hidden="true">
                <div class:list={['img-slot', { 'img-slot--warm': i % 3 === 1 }]}>
                  {d.image ? <img src={d.image} alt="" loading="lazy" /> : <span class="img-label"><Icon name="image" />Photograph: {d.name}</span>}
                </div>
              </a>
              {isMedia && (
                <a class="feature__play ping" href="/library/live" aria-label="Watch services live">
                  <span><Icon name="play" size={22} /></span>
                </a>
              )}
              <h3 class="feature__title"><a href={`/departments/${d.slug}`}>{n.light} <strong>{n.bold}</strong></a></h3>
              {d.summary ? <p>{d.summary}</p> : <p class="ph">[One or two sentences about the department]</p>}
              <a class="link-arrow" href={`/departments/${d.slug}`}>{isMedia ? 'Explore Media and Publicity' : `Explore ${d.name}`} <Icon name="arrow-right" /></a>
            </article>
          );
        })}
      </div>
      <p class="depts__all"><a class="btn btn--outline" href="/departments">See all nine departments</a></p>
    </div>
  </section>

  <!-- 7. Upcoming programmes -->
  {events.length > 0 && (
    <section class="section events bg-dark on-dark watermark-host">
      <span class="watermark" aria-hidden="true" data-dir="right">GATHER</span>
      <div class="container">
        <div class="row-head" data-reveal>
          <div>
            <p class="eyebrow">Church Calendar</p>
            <h2>Upcoming <strong>Programmes</strong></h2>
          </div>
          <a class="link-arrow" href="/calendar">Open the calendar <Icon name="arrow-right" /></a>
        </div>
        <ul class="events__list" data-reveal-group>
          {events.map((e) => (
            <li>
              <a class="ev" href={`/calendar/${e.id}`}>
                <span class="ev__date">
                  {e.data.sample ? <span class="ph">[Date]</span> : <><strong>{fmt(e.data.start, { day: 'numeric' })}</strong>{fmt(e.data.start, { month: 'short' })}</>}
                </span>
                <span class="ev__body">
                  <span class="chip">{e.data.category}</span>
                  <span class="ev__title">{e.data.title}</span>
                  <span class="ev__meta">{e.data.sample ? <span class="ph">[Time · Venue]</span> : `${e.data.time ?? fmt(e.data.start, { hour: 'numeric', minute: '2-digit' })}${e.data.venue ? ` · ${e.data.venue}` : ''}`}</span>
                </span>
                <span class="ev__go" aria-hidden="true"><Icon name="arrow-up-right" size={20} /></span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <!-- 8. Get involved -->
  <section class="section involved">
    <div class="container involved__grid">
      <div data-reveal>
        <p class="eyebrow">Next steps</p>
        <h2>Get <strong>Involved</strong></h2>
        <p class="involved__lead">Take your next step at GMI. Wherever you are on the journey, there is a place for you.</p>
      </div>
      <div class="acc" data-reveal-group>
        {steps.map((s, i) => (
          <details class="acc__item" open={i === 0}>
            <summary><span>{s.title}</span><span class="acc__pm" aria-hidden="true"></span></summary>
            <div class="acc__body">
              <p>{s.text}</p>
              <a class="link-arrow" href={s.href}>{s.cta} <Icon name="arrow-right" /></a>
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>
</Base>

<style>
  /* ---------- 1. Hero slider ---------- */
  .hero { position: relative; height: 100svh; min-height: 640px; max-height: 1000px; overflow: hidden; background: var(--blue-950); }
  .hero__slides { position: absolute; inset: 0; }
  .slide { position: absolute; inset: 0; display: flex; align-items: center; opacity: 0; visibility: hidden; transition: opacity 1s var(--ease), visibility 0s 1s; }
  .slide.is-active { opacity: 1; visibility: visible; transition: opacity 1s var(--ease); }
  .slide__bg { position: absolute; inset: -4%; background: var(--glow-hero); transform: scale(1.06); transition: transform 8s linear; }
  .slide.is-active .slide__bg { transform: scale(1); }
  .slide--b .slide__bg { background:
      radial-gradient(55% 65% at 15% 20%, rgba(217, 166, 58, 0.5), transparent 60%),
      radial-gradient(60% 70% at 90% 85%, rgba(53, 80, 200, 0.8), transparent 65%),
      linear-gradient(160deg, #111a44 0%, #1e3282 60%, #0a0f26 100%); }
  .slide--c .slide__bg { background:
      radial-gradient(50% 60% at 75% 75%, rgba(234, 192, 106, 0.55), transparent 60%),
      radial-gradient(70% 70% at 20% 30%, rgba(53, 80, 200, 0.7), transparent 70%),
      linear-gradient(200deg, #0a0f26 0%, #172766 55%, #111a44 100%); }
  .slide--d .slide__bg { background:
      radial-gradient(60% 60% at 50% 110%, rgba(217, 166, 58, 0.6), transparent 60%),
      radial-gradient(60% 60% at 85% 10%, rgba(53, 80, 200, 0.75), transparent 65%),
      linear-gradient(135deg, #1e3282 0%, #111a44 55%, #0a0f26 100%); }
  .slide__bg img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; mix-blend-mode: luminosity; opacity: 0.45; }
  .slide__bg::after { content: ''; position: absolute; inset: 0; background: linear-gradient(90deg, rgba(10, 15, 38, 0.75) 0%, rgba(10, 15, 38, 0.2) 70%), linear-gradient(0deg, rgba(10, 15, 38, 0.6), transparent 40%); }
  :global(.slide__rays) { right: -6%; bottom: -10%; width: 70%; height: 90%; z-index: 1; }
  .slide__inner { position: relative; z-index: 2; }
  .slide__copy { max-width: 760px; padding-top: 60px; }
  .slide .display { color: var(--white); }
  .slide__text { max-width: 560px; margin-top: var(--s-5); font-size: var(--fs-body-lg); color: rgba(255, 255, 255, 0.86); }
  .slide__ctas { display: flex; flex-wrap: wrap; gap: var(--s-3); margin-top: var(--s-6); }
  .slide__anim { opacity: 0; transform: translateY(26px); }
  .slide.is-active .slide__anim { opacity: 1; transform: none; transition: opacity 0.9s var(--ease-out), transform 0.9s var(--ease-out); }
  .slide.is-active .slide__anim:nth-child(2) { transition-delay: 0.12s; }
  .slide.is-active .slide__anim:nth-child(3) { transition-delay: 0.24s; }
  .slide.is-active .slide__anim:nth-child(4) { transition-delay: 0.36s; }

  .hero__controls { position: absolute; left: 0; right: 0; bottom: var(--s-7); z-index: 3; display: flex; align-items: center; justify-content: space-between; gap: var(--s-5); }
  .hero__dots { display: flex; gap: var(--s-4); list-style: none; margin: 0; padding: 0; }
  .hero__dots button { display: flex; flex-direction: column; gap: 8px; min-width: 64px; padding: 6px 0; background: none; border: 0; cursor: pointer; color: rgba(255, 255, 255, 0.6); text-align: left; }
  .hero__num { font-size: 0.8125rem; font-weight: 700; letter-spacing: 0.1em; }
  .hero__dots [aria-current='true'] { color: var(--white); }
  .hero__bar { display: block; height: 3px; border-radius: 3px; background: rgba(255, 255, 255, 0.22); overflow: hidden; }
  .hero__bar span { display: block; height: 100%; width: 0; background: var(--gold-500); }
  .hero__dots [aria-current='true'] .hero__bar span { width: 100%; transition: width var(--hero-dur, 7s) linear; }
  :global(.hero.is-paused) .hero__dots [aria-current='true'] .hero__bar span { width: 100%; transition: none; }
  .hero__btns { display: flex; gap: var(--s-2); }
  .hero__btn { display: grid; place-items: center; width: 46px; height: 46px; border-radius: 50%; border: 1px solid rgba(255, 255, 255, 0.35); background: rgba(255, 255, 255, 0.06); color: var(--white); cursor: pointer; backdrop-filter: blur(6px); transition: background 0.2s var(--ease), border-color 0.2s var(--ease); }
  .hero__btn:hover { background: var(--gold-500); border-color: var(--gold-500); color: var(--blue-950); }
  .hero__btn :global(.i-play) { display: none; }
  :global(.hero.is-paused) .hero__btn :global(.i-play) { display: block; }
  :global(.hero.is-paused) .hero__btn :global(.i-pause) { display: none; }
  .hero__btn :global(svg) { fill: none; }
  .hero__scroll { position: absolute; left: 50%; bottom: 22px; z-index: 3; translate: -50% 0; width: 24px; height: 38px; border: 2px solid rgba(255, 255, 255, 0.5); border-radius: 14px; }
  .hero__scroll span { position: absolute; left: 50%; top: 7px; width: 4px; height: 8px; margin-left: -2px; border-radius: 2px; background: var(--gold-400); animation: scrollCue 1.8s var(--ease) infinite; }
  @keyframes scrollCue { 0% { opacity: 0; transform: translateY(0); } 30% { opacity: 1; } 100% { opacity: 0; transform: translateY(12px); } }

  /* ---------- 2. About ---------- */
  .about__grid { display: grid; grid-template-columns: 1.05fr 0.95fr; gap: var(--s-9); align-items: center; }
  .about h2 { font-size: var(--fs-h1); margin-bottom: var(--s-5); }
  .about__quote { font-size: 1.25rem; font-weight: 600; font-style: italic; color: var(--ink); margin-bottom: var(--s-4); }
  .about__text { font-size: var(--fs-body-lg); }
  .about__ctas { display: flex; flex-wrap: wrap; align-items: center; gap: var(--s-5); margin-top: var(--s-6); }
  .about__media { position: relative; justify-self: center; width: min(100%, 460px); }
  .about__halo { position: absolute; inset: 8% -8% -6% 8%; border-radius: 999px 999px var(--r-panel) var(--r-panel); background: var(--glow-gold); opacity: 0.9; transform: rotate(4deg); }
  .about__img { position: relative; aspect-ratio: 4 / 5; border-radius: 999px 999px var(--r-panel) var(--r-panel); box-shadow: var(--shadow-lg); }
  .about__badge { position: absolute; left: -36px; bottom: 40px; display: flex; align-items: center; gap: 12px; padding: 14px 18px; background: var(--white); border-radius: var(--r-card); box-shadow: var(--shadow-md); font-size: 0.8125rem; color: var(--ink-3); animation: floaty 6s ease-in-out infinite; }
  .about__badge strong { display: block; color: var(--blue-900); font-size: 0.9375rem; }
  .about__badge-icon { display: grid; place-items: center; width: 40px; height: 40px; border-radius: 50%; background: var(--gold-100); color: var(--gold-700); }
  @keyframes floaty { 50% { transform: translateY(-10px); } }

  /* ---------- 3. Experience ---------- */
  .experience__grid { display: grid; grid-template-columns: 0.85fr 1.15fr; gap: var(--s-8); align-items: center; }
  .experience h2 { margin-bottom: var(--s-4); }
  .experience__copy p:not(.eyebrow) { margin-bottom: var(--s-6); font-size: var(--fs-body-lg); }
  .experience__panel { position: relative; padding: var(--s-7) 0 var(--s-7) var(--s-7); }
