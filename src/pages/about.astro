---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Pathways from '../components/Pathways.astro';
import Icon from '../components/Icon.astro';
import about from '../data/about.json';

type Value = { title: string; text: string };

const values: Value[] = about.values.length ? (about.values as Value[]) : [1, 2, 3, 4].map((n) => ({ title: `[Core value ${n}]`, text: '[One-sentence explanation]' }));
const valuesPh = !about.values.length;

const sections = [
  { id: 'our-story', label: 'Our Story' },
  { id: 'vision-and-mission', label: 'Vision & Mission' },
  { id: 'our-aim', label: 'Our Aim' },
  { id: 'core-values', label: 'Core Values' },
  { id: 'leadership', label: 'Leadership' },
];
const [pastor, wife] = about.leaders;
---
<Base title="About GMI" description="Gloryville Ministries International, Ibadan: a Spirit-inspired ministry with a mandate to raise an end-time army. Our story, vision, mission, aim, and our Senior Pastor and his wife.">
  <PageHero
    crumbs={[{ label: 'Home', href: '/' }, { label: 'About GMI' }]}
    eyebrow="About GMI"
    title="Raising an <em>end-time army</em>."
    intro={about.intro}
    introPlaceholder="[Short introduction to Gloryville Ministries International, supplied by the church]"
  />

  <nav class="section-bar" aria-label="On this page">
    <div class="container">
      <ul>
        {sections.map((s) => <li><a href={`#${s.id}`} data-section-link>{s.label}</a></li>)}
      </ul>
    </div>
  </nav>

  <!-- 01 Our story -->
  <section id="our-story" class="watermark-host section anchor">
    <span class="watermark" aria-hidden="true">STORY</span>
    <div class="container story">
      <div>
        <p class="eyebrow">01 · Our story</p>
        <h2 class="h1">How Gloryville <strong>began</strong></h2>
        {about.story.opening
          ? <p class="story__lead">{about.story.opening}</p>
          : <p class="story__lead ph">[Opening paragraph of GMI's story]</p>}
        {about.story.paragraphs.length
          ? about.story.paragraphs.map((p: string) => <p>{p}</p>)
          : <p class="ph small">[Two or three further paragraphs: how GMI started, who it serves and where it is going]</p>}
      </div>
      <div class="img-slot img-slot--warm arch story__img">
        {about.story.image
          ? <img src={about.story.image} alt="The Gloryville congregation in worship" loading="lazy" />
          : <span class="img-label"><Icon name="image" />Photograph: early or archival GMI image</span>}
      </div>
    </div>
  </section>

  <!-- 02 Vision & mission -->
  <section id="vision-and-mission" class="watermark-host section bg-dark on-dark anchor">
    <span class="watermark" aria-hidden="true" data-dir="right">VISION</span>
    <div class="container">
      <p class="eyebrow">02 · Vision &amp; Mission</p>
      <h2 class="h1">What we are <strong>called to</strong></h2>
      <div class="vision">
        <p class="calling__label">Our vision</p>
        <p class="vision__text">{about.vision.text}</p>
        <figure class="verse">
          <blockquote class="quote-serif">“{about.vision.verse}”</blockquote>
          <figcaption>{about.vision.scripture} ({about.bibleVersion})</figcaption>
        </figure>
      </div>
      <p class="calling__label mission__label">Our mission</p>
      <ol class="points">
        {about.mission.map((m, i) => (
          <li>
            <span class="points__num">{String(i + 1).padStart(2, '0')}</span>
            <p class="points__text">{m.text}</p>
            <p class="points__ref">{m.scripture}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- 03 Our aim -->
  <section id="our-aim" class="watermark-host section anchor">
    <span class="watermark" aria-hidden="true">AIM</span>
    <div class="container aim">
      <div>
        <p class="eyebrow">03 · Our aim</p>
        <h2 class="h1">What we are <strong>believing for</strong></h2>
      </div>
      <ol class="aims">
        {about.aims.map((a, i) => (
          <li>
            <span class="aims__num">{i + 1}</span>
            <div>
              <p class="aims__text">{a.text}</p>
              <p class="aims__ref">{a.scripture}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- 04 Core values -->
  <section id="core-values" class="watermark-host section anchor">
    <span class="watermark" aria-hidden="true">VALUES</span>
    <div class="container">
      <p class="eyebrow">04 · Core values</p>
      <h2>The values that <strong>shape us</strong></h2>
      {valuesPh && <p class="sub">Each value is shown with a short explanation once the church supplies them.</p>}
      <ol class="values">
        {values.map((v, i) => (
          <li>
            <span class="values__num">{String(i + 1).padStart(2, '0')}</span>
            <h3 class:list={['values__title', { ph: valuesPh }]}>{v.title}</h3>
            <p class:list={['small', { ph: valuesPh }]}>{v.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- 07 Leadership -->
  <section id="leadership" class="watermark-host section leaders-wrap anchor">
    <span class="watermark" aria-hidden="true" data-dir="right">LEADERSHIP</span>
    <div class="container">
      <p class="eyebrow">05 · Leadership</p>
      <h2>Our <strong>Senior Pastor</strong> and his wife</h2>
      <figure class="pq">
        <blockquote>“{about.pastorQuote.text}”</blockquote>
        <figcaption>{about.pastorQuote.by}</figcaption>
      </figure>
      <div class="leaders">
        {[pastor, wife].map((l, i) => (
          <article class:list={['leader', { 'leader--offset': i === 1 }]}>
            <div class="img-slot arch leader__img">
              {l.portrait
                ? <img src={l.portrait} alt={l.name} loading="lazy" />
                : <span class="img-label"><Icon name="image" />{i === 0 ? 'Portrait: Senior Pastor' : "Portrait: Senior Pastor's wife"}</span>}
            </div>
            <p class:list={['leader__role', { ph: !l.role }]}>{l.role || '[Her title or role]'}</p>
            <h3 class:list={['leader__name', { ph: !l.name }]}>{l.name || '[Full name and title]'}</h3>
            {l.bio.length ? l.bio.map((p: string) => <p>{p}</p>) : <p class="ph small">[Short biography, two to three paragraphs]</p>}
          </article>
        ))}
      </div>
    </div>
  </section>

  <Pathways />
</Base>

<style>
  /* Section bar: in-page navigation, sticks under the header */
  .section-bar { position: sticky; top: 77px; z-index: 20; background: var(--paper); border-bottom: 1px solid var(--line); }
  .section-bar ul { display: flex; gap: 4px; list-style: none; margin: 0; padding: 0; overflow-x: auto; scrollbar-width: none; }
  .section-bar ul::-webkit-scrollbar { display: none; }
  .section-bar a { display: block; padding: 14px 10px; font-size: 0.875rem; font-weight: 600; color: var(--ink-2); text-decoration: none; white-space: nowrap; border-bottom: 2px solid transparent; }
  .section-bar a:hover { color: var(--blue-700); }
  .section-bar a.is-active { color: var(--blue-700); border-bottom-color: var(--gold-500); }
  .anchor { scroll-margin-top: 140px; }

  .story { display: grid; grid-template-columns: 1.1fr 0.9fr; gap: var(--s-8); align-items: center; }
  .story h2 { margin-bottom: var(--s-5); }
  .story__lead { font-size: var(--fs-h3); font-weight: 600; line-height: 1.4; color: var(--ink); }
  .story__img { aspect-ratio: 3 / 4; max-width: 420px; justify-self: end; width: 100%; }

  .calling__label { font-size: var(--fs-label); font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--gold-400); margin-bottom: var(--s-3); }
  .vision { max-width: 900px; margin-top: var(--s-7); padding-top: var(--s-6); border-top: 1px solid rgba(255, 255, 255, 0.14); }
  .vision__text { font-size: clamp(1.625rem, 1.2rem + 1.6vw, 2.5rem); font-weight: 300; line-height: 1.25; letter-spacing: -0.02em; color: var(--white); margin-bottom: var(--s-5); }
  .verse { margin: 0; padding-left: var(--s-5); border-left: 2px solid var(--gold-500); }
  .verse blockquote { margin: 0; font-size: 1.1875rem; line-height: 1.55; color: rgba(255, 255, 255, 0.86); }
  .verse figcaption { margin-top: var(--s-2); font-size: var(--fs-small); font-weight: 700; color: var(--gold-400); }
  .mission__label { margin-top: var(--s-8); }
  .points { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--s-4); }
  .points li { display: flex; flex-direction: column; padding: var(--s-6) var(--s-5); border-radius: var(--r-card); background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.12); transition: background 0.3s var(--ease), transform 0.3s var(--ease-out); }
  .points li:hover { background: rgba(255, 255, 255, 0.09); transform: translateY(-4px); }
  .points__num { font-size: 2.25rem; font-weight: 800; letter-spacing: -0.03em; color: var(--gold-400); line-height: 1; margin-bottom: var(--s-4); }
  .points__text { flex: 1; font-size: 1.1875rem; line-height: 1.45; color: var(--white); margin-bottom: var(--s-4); }
  .points__ref { margin: 0; font-size: var(--fs-small); font-weight: 700; color: var(--gold-400); }

  .aim { display: grid; grid-template-columns: 0.8fr 1.2fr; gap: var(--s-8); align-items: start; }
  .aims { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--s-4); }
  .aims li { display: flex; gap: var(--s-5); padding: var(--s-6); background: var(--white); border: 1px solid var(--line); border-radius: var(--r-card); box-shadow: var(--shadow-sm); }
  .aims__num { flex: none; display: grid; place-items: center; width: 52px; height: 52px; border-radius: 50%; background: var(--gold-500); color: var(--blue-950); font-size: 1.375rem; font-weight: 800; }
  .aims__text { font-size: 1.1875rem; line-height: 1.5; color: var(--ink); margin-bottom: var(--s-2); }
  .aims__ref { margin: 0; font-size: var(--fs-small); font-weight: 700; color: var(--gold-700); }

  .pq { max-width: 760px; margin: var(--s-6) 0 0; padding: var(--s-5) var(--s-6); background: var(--white); border-left: 3px solid var(--gold-500); border-radius: 0 var(--r-card) var(--r-card) 0; }
  .pq blockquote { margin: 0; font-size: 1.375rem; font-weight: 300; line-height: 1.4; letter-spacing: -0.01em; color: var(--blue-900); }
  .pq figcaption { margin-top: var(--s-2); font-size: var(--fs-small); font-weight: 700; color: var(--gold-700); }

  .sub { max-width: 520px; margin-top: var(--s-3); }
  .values { list-style: none; margin: var(--s-7) 0 0; padding: var(--s-5) 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--s-5); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .values__num { font-family: var(--font-serif); font-size: 2.25rem; color: var(--gold-700); line-height: 1; }
  .values__title { font-size: 1.375rem; margin: var(--s-3) 0 var(--s-2); }

  .leaders-wrap { background: #eef2fa; }
  .leaders { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--s-6); margin-top: var(--s-7); }
  .leader--offset { margin-top: var(--s-8); }
  .leader__img { aspect-ratio: 4 / 5; margin-bottom: var(--s-5); }
  .leader__role { font-size: var(--fs-label); font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--ink-3); margin-bottom: 4px; }
  .leader__name { font-size: var(--fs-h3); margin-bottom: var(--s-3); }

  @media (max-width: 1180px) { .section-bar { top: 69px; } }
  @media (max-width: 1024px) {
    .values { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .aim { grid-template-columns: minmax(0, 1fr); gap: var(--s-6); }
  }
  @media (max-width: 760px) {
    .story, .aim, .leaders { grid-template-columns: minmax(0, 1fr); gap: var(--s-6); }
    .points { grid-template-columns: minmax(0, 1fr); }
    .aims li { padding: var(--s-5); gap: var(--s-4); }
    .story__img { justify-self: center; max-width: 320px; }
    .values { grid-template-columns: minmax(0, 1fr); }
    .leader--offset { margin-top: 0; }
  }
</style>

<script>
  // Highlight the section bar link for the section in view.
  const links = new Map<string, HTMLAnchorElement>();
  document.querySelectorAll<HTMLAnchorElement>('[data-section-link]').forEach((a) => links.set(a.hash.slice(1), a));
  const io = new IntersectionObserver(
    (entries) => {
      entries.forEach((e) => {
        if (!e.isIntersecting) return;
        links.forEach((a) => a.classList.remove('is-active'));
        const a = links.get(e.target.id);
        a?.classList.add('is-active');
        a?.scrollIntoView({ block: 'nearest', inline: 'nearest' });
      });
    },
    { rootMargin: '-30% 0px -60% 0px' },
  );
  links.forEach((_, id) => { const el = document.getElementById(id); if (el) io.observe(el); });
</script>
